# Every variable is optional — leave unset to keep the local/demo behaviour.
# PORT and PREFIX_PATH are injected by Kingdom; do not set them.

# External SSO (Google via st.login). Ask SecOps (#secops_on_schedule) for the OAuth client.
# Redirect URI to register: https://internal-tools.y.uno/yuno-alliance-portal/oauth2callback
AUTH_COOKIE_SECRET=        # generate with openssl rand -hex 32
AUTH_REDIRECT_URI=https://internal-tools.y.uno/yuno-alliance-portal/oauth2callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack alerts (webhook OR bot token)
SLACK_WEBHOOK_URL=
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#partnerships-only-visibility-integrations
SLACK_LEADS_CHANNEL=#partnership-leads

# Optional Claude enrichment for the connector search box
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
