# ─── External SSO (OIDC) ──────────────────────────────────────────────────────
# Copy to .streamlit/secrets.toml and fill in. Any provider block you complete
# flips its button on the sign-in screen from "Demo" to a live "SSO" redirect —
# no code change. Blocks you leave out simply stay in demo mode.
#
# secrets.toml is already covered by .gitignore. Never commit real values.
#
# Generate the cookie secret with:  python3 -c "import secrets;print(secrets.token_hex(32))"

[auth]
redirect_uri  = "http://localhost:8501/oauth2callback"
cookie_secret = "REPLACE_WITH_A_LONG_RANDOM_STRING"

# ── Google Workspace ──────────────────────────────────────────────────────────
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (Web application). Add the redirect_uri above to "Authorised redirect URIs".
[auth.google]
client_id           = ""
client_secret       = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# ── Microsoft Entra ID ────────────────────────────────────────────────────────
# entra.microsoft.com → App registrations → New registration → Web redirect URI.
# Swap <TENANT_ID> below, or use "organizations" for any work/school account.
[auth.microsoft]
client_id           = ""
client_secret       = ""
server_metadata_url = "https://login.microsoftonline.com/<TENANT_ID>/v2.0/.well-known/openid-configuration"

# ── Okta ──────────────────────────────────────────────────────────────────────
# Okta admin → Applications → Create App Integration → OIDC / Web Application.
[auth.okta]
client_id           = ""
client_secret       = ""
server_metadata_url = "https://<YOUR_ORG>.okta.com/.well-known/openid-configuration"

# ─── Slack alerts ─────────────────────────────────────────────────────────────
# Fires when an unrecognised provider reaches the Partner Alliance door.
# Until this is filled in, alerts are written to
# data/unrecognised_providers.jsonl and nothing is posted anywhere.
#
# Use EITHER an incoming webhook (simplest) OR a bot token with chat:write.
[slack]
channel       = "#partnerships-only-visibility-integrations"   # C0BFT5R743X
webhook_url   = ""    # https://hooks.slack.com/services/...
bot_token     = ""    # xoxb-...

# Where Lead Generation posts new-lead alerts. Every GM sits on this channel;
# the regional GM and the assigned BDM are named in each message. Until a
# webhook or bot token is set above, alerts are written to
# data/lead_alerts.jsonl and nothing is posted anywhere.
leads_channel = "#partnership-leads"

# ─── Optional: Claude enrichment for the connector search box ─────────────────
# The search box parses deterministically with no network. Adding a key lets one
# short call catch phrasing the tokeniser missed. It returns entities only —
# never a score, never a ranking — and any failure falls back silently.
[anthropic]
api_key = ""              # sk-ant-...
model   = "claude-opus-5"
